{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@activity/shared": ["./shared/types/index.ts"],
      "@activity/shared/*": ["./shared/types/*"]
    },
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": [
    "shared/types/**/*.ts",
    "server/src/**/*.ts",
    "client/src/**/*.ts",
    "client/src/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
